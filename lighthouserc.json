{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 30000,
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-gpu",
        "preset": "desktop",
        "maxWaitForLoad": 45000
      }
    },

    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.90 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "resource-summary:document:size": ["error", { "maxNumericValue": 17000 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 380000 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 80000 }],
        "resource-summary:image:size": ["error", { "maxNumericValue": 500000 }],
        "resource-summary:third-party:count": ["error", { "maxNumericValue": 2 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
