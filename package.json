{
  "name": "notes-print-optimizer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "clean": "next clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench",
    "test:smoke": "playwright test --config=playwright.config.ts",
    "test:ci": "vitest run && vitest bench && playwright test --config=playwright.config.ts",
    "build:wasm": "wasm-pack build --target web --release --out-dir pkg wasm && node -e \"require('fs').copyFileSync('wasm/pkg/npo_wasm_bg.wasm','public/wasm/npo_wasm_bg.wasm')\""
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
