{
  "name": "notes-print-optimizer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/postbuild-strip-devtools.js",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "npx rimraf .next out",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench",
    "test:smoke": "playwright test --config=playwright.config.ts",
    "fixtures:gen": "node scripts/gen-pdf-fixtures.mjs",
    "test:ci": "vitest run && vitest bench && playwright test --config=playwright.config.ts",
    "check:og": "node scripts/check-og-assets.mjs",
    "build:wasm": "wasm-pack build --target web --release --out-dir pkg wasm && node -e \"const f=require('fs');f.copyFileSync('wasm/pkg/npo_wasm_bg.wasm','public/wasm/npo_wasm_bg.wasm');f.copyFileSync('wasm/pkg/npo_wasm.js','public/wasm/npo_wasm.js');console.log('wasm glue+binary -> public/wasm/')\""
  },
  "dependencies": {
    "@pdfsmaller/pdf-encrypt": "^1.2.0",
    "@types/qrcode": "^1.5.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.553.0",
    "motion": "^12.23.24",
    "next": "^15.5.22",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qr-code-styling": "^1.9.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@napi-rs/canvas": "^0.1.52",
    "@next/bundle-analyzer": "^15.5.23",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.1.11",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.1",
    "eslint-config-next": "^15.5.22",
    "fake-indexeddb": "^5.0.2",
    "jsdom": "^24.0.0",
    "postcss": "^8.5.23",
    "serve": "^14.2.6",
    "tailwindcss": "4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vitest": "^1.6.0",
    "wabt": "^1.0.39"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.17"
  },
  "description": "Mobile-first adaptive print optimizer and PDF engine for PW lecture notes",
  "author": "juyel-dev",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/juyel-dev/Notes-Print-Optimizer.git"
  },
  "homepage": "https://print-optimizer.vercel.app",
  "bugs": {
    "url": "https://github.com/juyel-dev/Notes-Print-Optimizer/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Edge versions",
    "last 2 Firefox versions",
    "last 2 Safari versions"
  ],
  "keywords": [
    "pdf",
    "print",
    "optimizer",
    "notes",
    "education",
    "pwa",
    "wasm",
    "next.js",
    "ink-saver"
  ]
}
